# 운영 .env 예시. 실제 파일은 Jenkins 워크스페이스(oracle 호스트의
# /var/jenkins_home/workspace/news/.env)에만 둔다. 저장소에 넣지 않는다.

# Django
DJANGO_SECRET_KEY=change-me-50-random-chars
DJANGO_ALLOWED_HOSTS=news.sandcorp.co.kr
DJANGO_CSRF_TRUSTED_ORIGINS=https://news.sandcorp.co.kr
# Django admin 경로(추측하기 어려운 값, 끝의 / 생략 가능). 필수: 비우거나 admin이면 기동 실패.
# 기본 /admin/은 열지 않는다(404). 로그인은 sandcorp-auth로만 한다.
DJANGO_ADMIN_PATH=change-me-admin-path
# sitemap.xml 절대 URL 기준 (생략하면 https://news.sandcorp.co.kr)
SITE_URL=https://news.sandcorp.co.kr
# DJANGO_LOG_LEVEL=INFO

# sandcorp-auth (리소스 서버 + admin 로그인 기밀 클라이언트)
# 규칙: sandcorp-auth docs/resource-server-token-validation.md. 리소스(aud)는 ${SITE_URL}/mcp.
# AUTH_ISSUER=https://auth.sandcorp.co.kr
# 대표의 sandcorp-auth username. 토큰 sub가 이것과 다르면 거부(비우면 아무도 통과 못 함).
AUTH_OWNER_SUB=change-me-owner-username
# sandcorp-auth admin에서 등록한 기밀 클라이언트. 리다이렉트 URI는 ${SITE_URL}/auth/callback
AUTH_CLIENT_ID=change-me-client-id
AUTH_CLIENT_SECRET=change-me-client-secret
# AUTH_REDIRECT_URI=https://news.sandcorp.co.kr/auth/callback
# GUNICORN_WORKERS=2

# 운영 경보(편집자 미실행·소스 연속 실패)를 보낼 Discord 웹훅. 비우면 로그만 남긴다.
# DISCORD_WEBHOOK_URL=

# 편집자 파이프라인(ADR 0006). 키는 대표가 정한 이름으로만 읽는다(ANTHROPIC_API_KEY 아님).
# 키가 비었거나 모드가 off면 run_editor는 아무것도 하지 않는다. 운영 주입은 조율자가 전환 때 한다.
# SANDCORP_NEWS_CLAUDE_KEY=
# EDITOR_PIPELINE_MODE=off            # off / shadow (live는 #128)
# EDITOR_RUN_HOURS=6,12,18            # KST
# EDITOR_MODEL_CLASSIFY=claude-sonnet-5-5
# EDITOR_EFFORT_CLASSIFY=medium
# EDITOR_MODEL_WRITE=claude-sonnet-5-5  # 2단계 기사 작성
# EDITOR_EFFORT_WRITE=low
# EDITOR_MODEL_COMMENTARY=claude-opus-5-5  # 3단계 분석·포스트 초안(대표 결정)
# EDITOR_EFFORT_COMMENTARY=high
# EDITOR_USE_BATCH=true               # 2·3단계를 Message Batches(50% 할인)로. false면 동기(문제 시 되돌리는 스위치)
# EDITOR_BATCH_WAIT_SECONDS=900       # 한 주기에서 배치를 기다리는 최대 시간(30초 간격 확인)
# EDITOR_MODEL_CLASSIFY_COMPARE=      # 그림자 비교용 두 번째 분류 모델(예 claude-haiku-5-5), 비우면 끔
# EDITOR_MONTHLY_BUDGET_USD=18       # 월 예산 상한(US$). Console 지출 한도(월 $20)보다 낮게 — 넘으면 실행을 건너뛰고 경보
# EDITOR_MAX_ITEMS=60
# EDITOR_MAX_WRITES=30
# EDITOR_MAX_FEATURED=6
# EDITOR_MAX_COMMENTARY=4            # 슬롯당 3단계(분석) 호출 상한. 넘는 대상은 건너뜀으로 남긴다

# portfolio 문의 API(ADR 0003). 둘 중 하나라도 비면 문의는 전송하지 않고 대기열에만 쌓인다.
# PORTFOLIO_INQUIRY_URL=https://sandcorp.co.kr/api/inquiries
# PORTFOLIO_INQUIRY_SECRET=

# MySQL (운영: OCI MySQL HeatWave 사설 IP, DB는 utf8mb4 / utf8mb4_0900_as_cs — ADR 0004).
# web·scheduler가 읽는다. make prod-local에서는 DB_HOST·DB_PORT를 덮어쓰기가 정하고
# 나머지 셋으로 로컬 mysql 컨테이너를 만든다.
DB_HOST=10.0.0.x
DB_PORT=3306
DB_NAME=news
DB_USER=news
DB_PASSWORD=change-me

# web 바인딩(기본: oracle 덮어쓰기에서 172.17.0.1:18092)
# HTTP_BIND=172.17.0.1
# HTTP_PORT=18092

# 발행 시각이 수집 시각보다 이 일수 넘게 오래된 글은 수집물로 쌓지 않는다(기본 3)
# COLLECT_MAX_AGE_DAYS=3
# 수집 AI 판별(#160): off / shadow(기록만, 기본) / on(주제 밖이면 거름). 키는 SANDCORP_NEWS_CLAUDE_KEY
# COLLECT_AI_FILTER_MODE=shadow
# COLLECT_AI_FILTER_MODEL=claude-haiku-5-5
# COLLECT_AI_FILTER_BATCH=40
# COLLECT_AI_FILTER_TIMEOUT=30
# 직접 GET이 봇 차단(403·429·503·챌린지)이면 한 번 더 받는 대체 경로. {url} 자리에 원본 주소(비우면 끔)
# FETCH_FALLBACK_URL=https://r.jina.ai/{url}
# 미처리 수집물을 자동으로 버리기까지의 시간(기본 24)
# PENDING_MAX_AGE_HOURS=24
# 방문 메트릭 스니펫 주소(비우면 안 붙임)와 사이트 키(기본 foresight)
# METRICS_SNIPPET_URL=https://metrics.sandcorp.co.kr/m.js
# METRICS_SITE_KEY=foresight
